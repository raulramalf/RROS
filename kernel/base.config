# Común a todos los perfiles. Se fusiona sobre defconfig con merge_config.sh.
CONFIG_MODULES=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_KERNEL_ZSTD=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=m
CONFIG_VFAT_FS=y
CONFIG_ZRAM=m
CONFIG_ZSWAP=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
# Reducir tamaño: sin depuración
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_PROFILING is not set
