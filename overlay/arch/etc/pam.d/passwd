#%PAM-1.0
# RROS: las contraseñas nuevas pasan por pam_pwquality, que sigue las directivas de Ajustes → Seguridad
# (security.password_min_length y security.password_complex, en /etc/security/pwquality.conf.d/rros.conf)
password	required	pam_pwquality.so retry=3
password	required	pam_unix.so yescrypt shadow nullok use_authtok
