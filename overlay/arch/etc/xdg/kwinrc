# KWin en Lily, valores de todo el sistema hasta que rros-theme escribe los del perfil al iniciar sesión: sin los
# efectos que cuestan GPU (desenfoque, lámpara mágica), para que el primer arranque no vaya a tirones en equipos
# modestos ni en máquinas virtuales sin 3D. Botones de las ventanas a la derecha.
[org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__Lily
ButtonsOnLeft=
ButtonsOnRight=IAX
BorderSize=None
BorderSizeAuto=false

[Plugins]
blurEnabled=false
contrastEnabled=false
magiclampEnabled=false
squashEnabled=true
wobblywindowsEnabled=false

[Windows]
BorderlessMaximizedWindows=false

[Effect-overview]
BorderActivate=7

[NightColor]
Active=false

# la tecla Windows/Cmd sola abre el Launchpad de Lily Shell
[ModifierOnlyShortcuts]
Meta=org.rros.Shell,/Shell,org.rros.Shell,toggleLaunchpad
