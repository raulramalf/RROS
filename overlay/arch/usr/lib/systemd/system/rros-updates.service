[Unit]
Description=Lily: descargar las actualizaciones (se instalan con «rros apps update»)
Documentation=https://github.com/raulramalf/RROS/blob/main/docs/SEGURIDAD.md
Wants=network-online.target
After=network-online.target
ConditionACPower=true

[Service]
Type=oneshot
# los paquetes de Arch de hace una semana (rros-instantanea: el rodaje); después se descargan las actualizaciones.
# checkupdates usa su propia copia de la base de datos: no deja el sistema a medio actualizar
ExecStartPre=-/usr/bin/rros-instantanea avanzar
ExecStart=/usr/bin/checkupdates --download
# 2 = no hay actualizaciones
SuccessExitStatus=2
Nice=19
IOSchedulingClass=idle
