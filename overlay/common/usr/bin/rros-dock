#!/bin/sh
# Dock de aplicaciones (ui.dock): nwg-dock-hyprland en Hyprland, nwg-dock en sway. Se oculta solo.
pinned=${XDG_CACHE_HOME:-$HOME/.cache}/nwg-dock-pinned
if [ ! -s "$pinned" ]; then
	mkdir -p "$(dirname "$pinned")"
	printf '%s\n' org.gnome.Epiphany thunar foot org.xfce.mousepad rros-settings > "$pinned"
fi
if [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ] && command -v nwg-dock-hyprland >/dev/null 2>&1; then
	exec nwg-dock-hyprland -d -i 44 -mb 8 -c fuzzel
elif command -v nwg-dock >/dev/null 2>&1; then
	exec nwg-dock -d -i 44 -mb 8 -c fuzzel
fi
echo "rros-dock: no hay dock instalado (nwg-dock-hyprland o nwg-dock)" >&2
exit 1
