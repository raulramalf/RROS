#!/bin/sh
# Primer inicio de sesión: carpetas del usuario, plantillas, marcadores, Flathub y bienvenida.
flag="${XDG_CONFIG_HOME:-$HOME/.config}/rros/.primer-inicio"
[ -e "$flag" ] && exit 0
mkdir -p "$(dirname "$flag")" "$HOME/.local/bin"
# carpetas en español (ver /etc/xdg/user-dirs.defaults)
xdg-user-dirs-update 2>/dev/null
# plantillas para «Crear documento» del gestor de archivos y para rros-new
tpl=$(xdg-user-dir TEMPLATES 2>/dev/null)
if [ -n "$tpl" ] && [ "$tpl" != "$HOME" ]; then
	rros-new exportar "$tpl" >/dev/null 2>&1
fi
# marcadores del gestor de archivos y de los diálogos de abrir/guardar
bm="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/bookmarks"
if [ ! -e "$bm" ]; then
	mkdir -p "$(dirname "$bm")"
	for d in DOCUMENTS DOWNLOAD PICTURES MUSIC VIDEOS; do
		p=$(xdg-user-dir "$d" 2>/dev/null)
		if [ -z "$p" ] || [ "$p" = "$HOME" ] || [ ! -d "$p" ]; then
			continue
		fi
		# URI con los caracteres no ASCII de los nombres en español codificados
		uri=$(printf '%s' "$p" | sed -e 's/ /%20/g' -e 's/á/%C3%A1/g' -e 's/é/%C3%A9/g' -e 's/í/%C3%AD/g' \
			-e 's/ó/%C3%B3/g' -e 's/ú/%C3%BA/g' -e 's/ñ/%C3%B1/g')
		echo "file://$uri $(basename "$p")" >> "$bm"
	done
fi
# Flathub para la tienda de aplicaciones (necesita red; si no hay, se reintenta al instalar)
(rros-apps setup >/dev/null 2>&1) &
touch "$flag"
# la ventana de bienvenida (también con Super+F1): modo de ventanas, atajos y, en el live, instalar
if [ -n "${WAYLAND_DISPLAY:-}" ]; then
	(sleep 4; rros-settings open bienvenida >/dev/null 2>&1) &
fi
notify-send "Bienvenido a RROS" "Super+D aplicaciones · Super+F1 ayuda · Super+, ajustes" 2>/dev/null
