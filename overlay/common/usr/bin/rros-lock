#!/bin/sh
# Bloquea la pantalla: hyprlock en Hyprland (con el fondo y los colores del tema) o swaylock.
#   rros-lock      bloquea y espera a que se desbloquee
#   rros-lock -f   bloquea y vuelve enseguida (para swayidle)
if [ "${1:-}" = -f ]; then
	setsid rros-lock >/dev/null 2>&1 &
	exit 0
fi
pidof hyprlock swaylock >/dev/null 2>&1 && exit 0
if [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ] && command -v hyprlock >/dev/null 2>&1; then
	hyprlock && exit 0
	echo "rros-lock: hyprlock ha fallado; se usa swaylock" >&2
fi
exec swaylock
