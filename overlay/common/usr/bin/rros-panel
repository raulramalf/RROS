#!/bin/sh
# Lanza el panel (waybar): espera a que exista el bus de la sesión y a que el portal XDG responda
# (waybar lo consulta al arrancar y, si tarda, se cierra), y lo reinicia si se cierra.
# Si se cierra cinco veces seguidas en menos de dos segundos, se rinde para no ciclar sin fin.
n=0
while [ "$n" -lt 40 ] && ! busctl --user status >/dev/null 2>&1; do
	sleep 0.5
	n=$((n + 1))
done
# activa el portal ahora (espera como máximo un minuto; si no hay portal sigue adelante)
timeout 60 busctl --user call org.freedesktop.portal.Desktop /org/freedesktop/portal/desktop \
	org.freedesktop.DBus.Peer Ping >/dev/null 2>&1
fails=0
while [ "$fails" -lt 5 ]; do
	start=$(date +%s)
	waybar
	if [ $(($(date +%s) - start)) -lt 2 ]; then
		fails=$((fails + 1))
	else
		fails=0
	fi
	sleep 1
done
echo "rros-panel: waybar se cierra al arrancar; revisa ~/.config/waybar" >&2
exit 1
