#!/bin/sh
# Menú de energía: bloquear, cerrar sesión, suspender, reiniciar y apagar.
choice=$(printf 'Bloquear\nCerrar sesión\nSuspender\nReiniciar\nApagar\n' | fuzzel --dmenu --prompt 'Energía > ' --lines 5) || exit 0

confirm() {
	[ "$(printf 'No\nSí\n' | fuzzel --dmenu --prompt "$1 > " --lines 2)" = "Sí" ]
}

case "$choice" in
	Bloquear) exec rros-lock -f ;;
	"Cerrar sesión")
		confirm "¿Cerrar sesión?" || exit 0
		if [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then exec hyprctl dispatch exit; fi
		exec swaymsg exit
		;;
	Suspender) exec systemctl suspend ;;
	Reiniciar) confirm "¿Reiniciar?" && exec systemctl reboot ;;
	Apagar) confirm "¿Apagar?" && exec systemctl poweroff ;;
esac
