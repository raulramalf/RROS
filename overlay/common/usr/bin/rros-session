#!/bin/sh
# Prepara el tema y arranca el escritorio RROS: Hyprland, o sway si se elige (ui.compositor = sway),
# si Hyprland no está instalado o si el equipo no tiene aceleración gráfica (máquinas virtuales,
# hardware muy antiguo), porque Hyprland la necesita.
comp=$(rros-config get ui.compositor 2>/dev/null)
use=sway
if [ "$comp" != sway ] && { command -v Hyprland >/dev/null 2>&1 || command -v start-hyprland >/dev/null 2>&1; }; then
	if ls /dev/dri/renderD* >/dev/null 2>&1; then
		use=hyprland
	else
		echo "rros-session: sin aceleración gráfica: se usa sway en lugar de Hyprland" >&2
	fi
fi
export RROS_SESSION=$use
rros-theme apply --quiet || echo "rros-session: aviso: no se pudo aplicar el tema" >&2
export XDG_SESSION_TYPE=wayland MOZ_ENABLE_WAYLAND=1 QT_QPA_PLATFORM=wayland _JAVA_AWT_WM_NONREPARENTING=1
if [ "$use" = hyprland ]; then
	export XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_DESKTOP=Hyprland
	command -v start-hyprland >/dev/null 2>&1 && exec start-hyprland
	exec Hyprland
fi
export XDG_CURRENT_DESKTOP=sway XDG_SESSION_DESKTOP=sway
# sin GPU con aceleración: render por software
if [ -z "$WLR_RENDERER" ] && ! ls /dev/dri/renderD* >/dev/null 2>&1; then
	export WLR_RENDERER=pixman
fi
command -v swayfx >/dev/null 2>&1 && exec swayfx "$@"
exec sway "$@"
