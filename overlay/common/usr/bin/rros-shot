#!/bin/sh
# Captura de pantalla: rros-shot [region]
dir=${XDG_PICTURES_DIR:-$HOME/Pictures}
mkdir -p "$dir"
f="$dir/rros-$(date +%Y%m%d-%H%M%S).png"
if [ "${1:-}" = region ]; then
	grim -g "$(slurp)" "$f"
else
	grim "$f"
fi
command -v notify-send >/dev/null 2>&1 && notify-send "RROS" "Captura guardada: $f"
