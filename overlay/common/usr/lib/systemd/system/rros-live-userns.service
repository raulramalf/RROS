[Unit]
Description=RROS live: aislamiento de navegador y Flatpak sin perfiles de AppArmor
# Ubuntu restringe los espacios de nombres sin privilegios (bwrap, el aislamiento de WebKit y de
# Flatpak) a los programas con perfil de AppArmor, pero en el live no carga los perfiles: sin esto
# Epiphany y las apps Flatpak no arrancan. En el sistema instalado los perfiles sí se cargan.
ConditionKernelCommandLine=boot=casper
DefaultDependencies=no
After=systemd-sysctl.service
Before=rros-live.service getty.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/sysctl -qw kernel.apparmor_restrict_unprivileged_userns=0

[Install]
WantedBy=sysinit.target
