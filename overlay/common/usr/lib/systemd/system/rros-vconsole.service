[Unit]
Description=RROS: teclado de la consola (/etc/default/keyboard)
# Ubuntu no trae systemd-vconsole-setup ni los mapas de kbd: rros-vconsole genera el mapa con ckbcomp
# (la misma distribución XKB del escritorio) y lo carga antes del login en tty1
DefaultDependencies=no
After=systemd-remount-fs.service keyboard-setup.service
Before=getty.target getty@tty1.service
ConditionPathExists=/etc/default/keyboard

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/rros-vconsole

[Install]
WantedBy=sysinit.target
