#!/bin/sh
# Autotest de arranque: comprueba que el sistema está completo y lo cuenta por la consola.
# Se activa con el parámetro del kernel `rros.selftest` (ver rros-selftest.service). Vale para el sistema live y
# para el instalado (la prueba de instalación instala con el usuario «rros» y el equipo «rros-prueba»).
ok=0 bad=0
# las comprobaciones leen la salida de programas: siempre en inglés, sea cual sea el idioma del sistema
export LC_ALL=C
check() { # check "descripción" comando...
	desc=$1; shift
	if "$@" >/dev/null 2>&1; then ok=$((ok + 1)); echo "[ok]   $desc"; else bad=$((bad + 1)); echo "[FALLO] $desc"; fi
}
as_user() { su rros -c "$*"; }
mkdir -p /tmp/xrd-selftest && chown rros /tmp/xrd-selftest && chmod 700 /tmp/xrd-selftest
has() { command -v "$1" >/dev/null 2>&1; }

echo "=== RROS selftest ==="
# shellcheck source=/dev/null
. /etc/os-release
check "identidad: ID=rros ($PRETTY_NAME)" test "$ID" = rros
check "perfil activo: $(cat /etc/rros/profile 2>/dev/null)" test -s /etc/rros/profile
# sistema live (ISO) o instalado en un disco
LIVE=0
grep -qE 'boot=casper|archisobasedir=' /proc/cmdline && LIVE=1
echo "sistema: $([ "$LIVE" -eq 1 ] && echo live || echo instalado)"
check "usuario 'rros'" id rros
check "no existe el usuario 'ubuntu'" sh -c '! id ubuntu'
# el nombre del equipo, del kernel (Arch no trae la orden hostname)
host=$(cat /proc/sys/kernel/hostname)
check "nombre de equipo: $host" sh -c "case '$host' in rros*) true ;; *) false ;; esac"
check "kernel $(uname -r)" test -n "$(uname -r)"

# base del sistema: ubuntu o arch (la escribe apply-identity.sh)
BASE=ubuntu
if [ -r /etc/rros/identity ]; then BASE=$(sed -n 's/^RROS_BASE=//p' /etc/rros/identity); fi
[ -n "$BASE" ] || { [ -e /etc/arch-release ] && BASE=arch || BASE=ubuntu; }
echo "base: $BASE"

# aplicaciones: las de KDE en Arch (escritorio Plasma), las GTK en Ubuntu
if [ "$BASE" = arch ]; then
	apps="plasmashell kwin_wayland sddm firefox dolphin konsole kate okular gwenview ark kcalc spectacle"
	desks="firefox org.kde.dolphin org.kde.konsole org.kde.kate org.kde.okular org.kde.gwenview org.kde.ark org.kde.kcalc mpv"
else
	apps="epiphany thunar mousepad evince file-roller galculator nm-applet blueman-applet udiskie pavucontrol"
	desks="org.gnome.Epiphany thunar org.xfce.mousepad org.gnome.Evince mpv org.gnome.FileRoller galculator imv"
fi
for app in $apps sway waybar foot fuzzel mako mpv btop flatpak swaylock swayidle swaybg grim slurp cliphist \
           rros rros-config rros-theme rros-apps rros-settings rros-apply rros-security rros-devices rros-new \
           rros-lock rros-dock rros-updates rros-informe nft rfkill udisksctl xdg-user-dir; do
	check "programa: $app" has "$app"
done
for desk in $desks; do
	check "lanzador: $desk.desktop" test -e "/usr/share/applications/$desk.desktop"
done

check "NetworkManager activo" systemctl is-active --quiet NetworkManager
check "polkit activo (o disponible)" sh -c 'systemctl is-active --quiet polkit || test -x /usr/bin/pkexec'
check "snap no instalado" sh -c '! test -e /usr/bin/snap'
check "rros-apply se ejecutó" systemctl is-active --quiet rros-apply
check "zram como swap" sh -c 'swapon --show | grep -q zram'
check "identidad: os-release de RROS" grep -q '^ID=rros' /etc/os-release

check "rros doctor (usuario)" as_user "rros doctor"
for tool in rros-install rros-installer sfdisk mkfs.ext4 mkfs.vfat grub-install efibootmgr tar cryptsetup os-prober; do
	check "instalador: $tool" has "$tool"
done
# shellcheck disable=SC2016
check "instalador: rros-installer disks" sh -c 'rros-installer disks --json | grep -q "\"disks\""'
check "red: el cable lo gestiona NetworkManager" sh -c '! nmcli -t dev status | grep -q ":ethernet:unmanaged"'
check "locale es_ES.UTF-8 generado" sh -c 'locale -a | grep -qix es_ES.utf8'
# seguridad (la aplica rros-apply al arrancar)
check "cortafuegos: tabla inet rros con política drop" sh -c 'nft list table inet rros | grep -q "policy drop"'
check "cortafuegos: nftables arranca con el sistema" systemctl is-enabled --quiet nftables
check "kernel endurecido (kptr_restrict = 2)" test "$(sysctl -n kernel.kptr_restrict 2>/dev/null)" = 2
check "kernel endurecido (protected_regular = 2)" test "$(sysctl -n fs.protected_regular 2>/dev/null)" = 2
# el aislamiento que usan Epiphany (WebKit) y Flatpak: crear un espacio de nombres como usuario
check "aislamiento de aplicaciones (bwrap) como usuario" as_user "bwrap --ro-bind / / --dev /dev --proc /proc true"
check "sudo: configuración de RROS válida" sh -c 'visudo -cqf /etc/sudoers.d/rros'
# shellcheck disable=SC2016
check "rros-security: auditoría" sh -c 'rros-security --json | grep -q "\"score\""'
# dispositivos y archivos
# shellcheck disable=SC2016
check "rros-devices: ve la tarjeta de red" sh -c 'rros-devices lista red --json | grep -q "\"cat\":\"red\""'
check "rros-new: crea un script ejecutable" as_user "cd /tmp && rm -f rros-selftest.sh && rros-new bash rros-selftest >/dev/null && test -x /tmp/rros-selftest.sh"
check "primer inicio: carpetas en español y plantillas" as_user "rros-first-login; test -d ~/Documentos && test -f ~/Plantillas/'Script de Bash.sh'"
check "blueman-mechanism no arranca en el boot (solo por D-Bus)" sh -c '! systemctl is-enabled --quiet blueman-mechanism'
if [ "$BASE" = arch ]; then
	# Plasma: SDDM (con inicio automático en el live) y la sesión del usuario con la distribución de RROS
	check "pantalla de inicio de sesión (SDDM) activa" systemctl is-active --quiet sddm
	if [ "$LIVE" -eq 1 ]; then
		check "live: inicio automático en Plasma" grep -qs '^User=rros' /etc/sddm.conf.d/20-rros-live.conf
		i=0
		while ! pgrep -u rros -x plasmashell >/dev/null 2>&1 && [ "$i" -lt 150 ]; do sleep 2; i=$((i + 2)); done
		check "sesión de Plasma arrancada (plasmashell, ${i} s)" pgrep -u rros -x plasmashell
		check "KWin en marcha (compositor Wayland)" pgrep -u rros -x kwin_wayland
		if ! pgrep -u rros -x plasmashell >/dev/null 2>&1; then   # para saber por qué: sesión y registro de SDDM
			echo "--- sesiones ---"; loginctl list-sessions --no-legend 2>&1 | head -5
			for sid in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
				loginctl show-session "$sid" -p Type -p Desktop -p Service 2>&1 | tr '\n' ' '; echo
			done
			echo "--- sddm ---"; journalctl -b -u sddm --no-pager 2>&1 | tail -n 25
			echo "--- plasma (usuario) ---"; journalctl -b _UID="$(id -u rros)" --no-pager 2>&1 | grep -iE 'plasma|kwin|error|fail' | tail -n 25
		fi
		i=0
		while ! grep -qs icontasks ~rros/.config/plasma-org.kde.plasma.desktop-appletsrc && [ "$i" -lt 60 ]; do sleep 2; i=$((i + 2)); done
		check "Plasma usó la distribución de RROS (barra arriba y dock)" grep -qs 'org.kde.plasma.icontasks' ~rros/.config/plasma-org.kde.plasma.desktop-appletsrc
		check "menú global en la barra de arriba" grep -qs 'org.kde.plasma.appmenu' ~rros/.config/plasma-org.kde.plasma.desktop-appletsrc
		i=0
		while ! ls ~rros/.local/share/color-schemes/RROS-*.colors >/dev/null 2>&1 && [ "$i" -lt 60 ]; do sleep 2; i=$((i + 2)); done
		check "colores y barras de título del tema de RROS aplicados al iniciar sesión" sh -c 'ls ~rros/.local/share/color-schemes/RROS-*.colors && test -f ~rros/.local/share/aurorae/themes/RROS/decoration.svg'
		# el escritorio está listo: test-iso.sh hace aquí la captura de pantalla por el monitor de QEMU
		sleep 10
		echo "RROS_PANTALLA_LISTA"
		sleep 6
	fi
fi
if [ "$LIVE" -eq 1 ] && [ "$BASE" != arch ]; then
	check "tty1: rros-live activo y getty parado en el live" sh -c 'systemctl is-active --quiet rros-live && ! systemctl is-active --quiet getty@tty1'
elif [ "$LIVE" -eq 0 ] && [ "$BASE" = arch ]; then
	check "instalado: sin inicio automático (SDDM pide usuario y contraseña)" sh -c '! test -e /etc/sddm.conf.d/20-rros-live.conf'
fi
if [ "$LIVE" -eq 0 ]; then
	[ "$BASE" = arch ] || check "instalado: inicio de sesión normal en tty1 (sin el automático del live)" sh -c '! systemctl is-active --quiet rros-live && systemctl is-active --quiet getty@tty1'
	check "instalado: el usuario tiene contraseña" sh -c 'passwd -S rros | grep -q " P "'
	check "instalado: el usuario administra (sudo)" sh -c 'id -nG rros | grep -qwE "wheel|sudo"'
	check "instalado: la raíz está en /etc/fstab" grep -qE '^[^#[:space:]]+[[:space:]]+/[[:space:]]' /etc/fstab
	check "instalado: GRUB con la entrada de RROS" sh -c 'grep -q RROS /boot/grub/grub.cfg'
	check "instalado: zona horaria de la instalación" sh -c 'readlink /etc/localtime | grep -q Europe/Madrid'
	if [ -d /sys/firmware/efi ]; then
		check "instalado: arranque UEFI (partición EFI montada, con GRUB)" sh -c 'mountpoint -q /boot/efi && test -e /boot/efi/EFI/BOOT/BOOTX64.EFI'
	fi
fi
# shellcheck disable=SC2016
check "catálogo de apps (54)" sh -c 'test "$(rros-apps list | wc -l)" -ge 50'
check "mimeapps: navegador por defecto" sh -c 'grep -qE "Epiphany|firefox" /etc/xdg/mimeapps.list'

if [ "$BASE" = arch ]; then
	for app in Hyprland hyprctl hyprlock nwg-dock-hyprland pacman arch-chroot genfstab mkinitcpio; do
		check "Arch: $app" has "$app"
	done
	check "idioma del sistema: español" grep -q '^LANG=es_ES.UTF-8' /etc/locale.conf
	check "traducciones de GTK y NetworkManager" test -f /usr/share/locale/es/LC_MESSAGES/gtk30.mo -a -f /usr/share/locale/es/LC_MESSAGES/nm-applet.mo
	check "teclado de la consola: español" sh -c 'grep -q "^KEYMAP=es" /etc/vconsole.conf && ls /usr/share/kbd/keymaps/i386/qwerty/es.map*'
	check "bloqueo tras contraseñas fallidas (pam_faillock)" grep -q pam_faillock /etc/pam.d/system-auth
	check "sudo: el grupo wheel administra" sh -c 'visudo -cqf /etc/sudoers.d/10-rros-wheel'
	check "instalador: cifrado en el initramfs (hook sd-encrypt)" test -e /usr/lib/initcpio/install/sd-encrypt
	check "zona horaria configurada (sin preguntas de systemd-firstboot)" sh -c 'test -e /etc/localtime && systemctl is-enabled systemd-firstboot.service 2>/dev/null | grep -q masked'
	check "Plasma: aspecto de RROS (paquete, colores, barras de título, fondo)" sh -c 'test -f /usr/share/plasma/look-and-feel/org.rros.desktop/contents/layouts/org.kde.plasma.desktop-layout.js && grep -q "Colors:Window" /etc/xdg/kdeglobals && test -f /usr/share/aurorae/themes/RROS/close.svg && test -s /usr/share/wallpapers/RROS/contents/images/1920x1080.png'
	check "AppArmor activo (lsm= en el arranque)" test "$(cat /sys/module/apparmor/parameters/enabled 2>/dev/null)" = Y
	check "AppArmor: perfiles cargados" sh -c 'systemctl is-active --quiet apparmor && grep -q . /sys/kernel/security/apparmor/profiles'
	check "actualizaciones: descarga diaria (rros-updates.timer)" sh -c 'command -v checkupdates >/dev/null && systemctl is-enabled --quiet rros-updates.timer'
	check "faillock: límite de intentos de RROS" grep -q '^deny = ' /etc/security/faillock.conf
	check "live: el sistema a copiar está montado" sh -c '! grep -q archisobasedir /proc/cmdline || test -d /run/archiso/airootfs/etc'
	if [ "$LIVE" -eq 0 ]; then
		check "instalado: initramfs propio (sin los hooks de archiso)" sh -c '! test -e /etc/mkinitcpio.conf.d/archiso.conf && lsinitcpio /boot/initramfs-linux.img | grep -q "usr/lib/systemd/systemd" && ! lsinitcpio /boot/initramfs-linux.img | grep -q hooks/archiso'
		check "instalado: sin el llavero temporal del live" sh -c '! test -e /etc/systemd/system/pacman-init.service'
		check "instalado: llavero de pacman inicializado" sh -c 'pacman-key --list-keys >/dev/null 2>&1'
		check "instalado: kernel en /boot" test -e /boot/vmlinuz-linux
		if grep -qs '^rros-root ' /etc/crypttab; then
			check "instalado: raíz cifrada con LUKS2 y abierta en el arranque" sh -c 'cryptsetup status rros-root | grep -q "type: *LUKS2"'
		fi
	fi
else
	for app in unattended-upgrade apparmor_parser ckbcomp; do
		check "Ubuntu: $app" has "$app"
	done
	check "idioma del sistema: español" grep -q '^LANG=es_ES.UTF-8' /etc/default/locale
	check "traducciones de GTK y NetworkManager (paquetes de idioma)" test -f /usr/share/locale-langpack/es/LC_MESSAGES/gtk30.mo -a -f /usr/share/locale-langpack/es/LC_MESSAGES/nm-applet.mo
	check "sin telemetría (apport/whoopsie)" sh -c '! systemctl is-enabled --quiet apport 2>/dev/null'
	check "perfiles de AppArmor de Epiphany y Flatpak presentes" test -f /etc/apparmor.d/epiphany -a -f /etc/apparmor.d/flatpak
	check "AppArmor activo" test "$(cat /sys/module/apparmor/parameters/enabled 2>/dev/null)" = Y
	check "bloqueo tras contraseñas fallidas (pam_faillock)" grep -q pam_faillock /etc/pam.d/common-auth
	check "actualizaciones de seguridad automáticas" grep -q 'Unattended-Upgrade "1"' /etc/apt/apt.conf.d/20auto-upgrades
	check "teclado de la consola: rros-vconsole activo" systemctl is-active --quiet rros-vconsole
	# el mapa lo genera ckbcomp (Ubuntu no trae los de kbd): en el español, la tecla 2 lleva " con Mayús
	check "teclado de la consola: mapa español" sh -c "zcat /etc/console-setup/cached_UTF-8_del.kmap.gz | grep -q '^keycode 3 = U+0032 U+0022'"
	check "instalador: el initramfs puede llevar cryptsetup" test -x /usr/share/initramfs-tools/hooks/cryptroot
	check "ISO: tamaño del sistema para el progreso de la copia" sh -c '! grep -q boot=casper /proc/cmdline || test -s /cdrom/casper/filesystem.size'
fi

# escritorio: el tema se genera (Hyprland y sway), con fondo
check "rros-theme apply (usuario)" as_user "rros-theme apply --quiet"
check "fondo de pantalla generado" as_user "ls ~/.local/share/rros/fondos/*.png"
check "waybar: configuración generada" as_user "grep -q modules-left ~/.config/waybar/config"
check "GTK y terminal configurados" as_user "test -s ~/.config/gtk-4.0/gtk.css && test -s ~/.config/foot/foot.ini && test -s ~/.config/swaylock/config"
check "configuración de sway válida" as_user "XDG_RUNTIME_DIR=/tmp/xrd-selftest WLR_BACKENDS=headless WLR_LIBINPUT_NO_DEVICES=1 WLR_RENDERER=pixman sway --validate"
# arranca sway de verdad sin pantalla: si algún comando de la configuración falla, sway lanza swaynag (la barra roja)
check "sway arranca sin errores de configuración" as_user "XDG_RUNTIME_DIR=/tmp/xrd-selftest WLR_BACKENDS=headless WLR_LIBINPUT_NO_DEVICES=1 WLR_RENDERER=pixman sh -c 'timeout 5 sway -d > /tmp/sway-selftest.log 2>&1; ! grep -q \"namespace swaynag\" /tmp/sway-selftest.log'"
if has Hyprland; then
	check "configuración de Hyprland válida" as_user "XDG_RUNTIME_DIR=/tmp/xrd-selftest Hyprland --verify-config -c ~/.config/hypr/hyprland.conf"
fi

# medidas (informativas, no cuentan): memoria usada con el escritorio arrancado y tamaño del sistema
echo "info: memoria usada $(awk '/^MemTotal:/ {t=$2} /^MemAvailable:/ {a=$2} END {printf "%d MB de %d MB", (t-a)/1024, t/1024}' /proc/meminfo)"
echo "info: sistema instalado $(du -sxm / 2>/dev/null | cut -f1) MB (sin /home ni /tmp)"
for sfs in /run/archiso/bootmnt/arch/x86_64/airootfs.sfs /cdrom/casper/filesystem.squashfs; do
	[ -e "$sfs" ] && echo "info: imagen comprimida del sistema $(du -m "$sfs" | cut -f1) MB"
done
echo "=== resultado: $ok correctas, $bad con fallo ==="
[ "$bad" -eq 0 ] && echo "RROS_SELFTEST_OK" || echo "RROS_SELFTEST_FAIL"
