#!/bin/sh
# Autotest de arranque: comprueba que el sistema está completo y lo cuenta por la consola.
# Se activa con el parámetro del kernel `rros.selftest` (ver rros-selftest.service). Vale para el sistema live y
# para el instalado (la prueba de instalación instala con el usuario «rros» y el equipo «lily-prueba»).
ok=0 bad=0
# las comprobaciones leen la salida de programas: siempre en inglés, sea cual sea el idioma del sistema
export LC_ALL=C
check() { # check "descripción" comando...
	desc=$1; shift
	if "$@" >/dev/null 2>&1; then ok=$((ok + 1)); echo "[ok]   $desc"; else bad=$((bad + 1)); echo "[FALLO] $desc"; fi
}
as_user() { su rros -c "$*"; }
mkdir -p /tmp/xrd-selftest && chown rros /tmp/xrd-selftest && chmod 700 /tmp/xrd-selftest
has() { command -v "$1" >/dev/null 2>&1; }
# procesador ocupado en reposo durante 10 s (informativo): lo que gasta el sistema sin hacer nada
cpu_idle() {
	# shellcheck disable=SC2046  # dos números separados por un espacio
	set -- $(awk '/^cpu / {print $2+$3+$4+$7+$8, $5+$6}' /proc/stat)
	b1=$1 i1=$2
	sleep 10
	# shellcheck disable=SC2046
	set -- $(awk '/^cpu / {print $2+$3+$4+$7+$8, $5+$6}' /proc/stat)
	echo "info: procesador en reposo $(awk -v b="$(($1 - b1))" -v i="$(($2 - i1))" 'BEGIN { if (b + i > 0) printf "%.1f", 100 * b / (b + i); else print 0 }') % ocupado (media de 10 s, $(nproc) hilos)"
}

echo "=== Lily selftest ==="
# shellcheck source=/dev/null
. /etc/os-release
check "identidad: ID=rros ($PRETTY_NAME)" test "$ID" = rros
check "perfil activo: $(cat /etc/rros/profile 2>/dev/null)" test -s /etc/rros/profile
# una sola Lily: el nivel (ligero, equilibrado o máximo) lo pone rros-nivel en el arranque según este equipo
echo "info: $(rros-nivel 2>/dev/null | tr '\n' ' ')"
# shellcheck disable=SC2016  # se evalúa dentro del sh -c
check "nivel ajustado a este equipo ($(rros-hwdetect --profile 2>/dev/null))" sh -c '[ -s /etc/rros/nivel ] || [ "$(cat /etc/rros/profile)" = "$(rros-hwdetect --profile)" ]'
check "systemd-oomd en marcha (evita que el equipo se congele sin memoria)" systemctl is-active --quiet systemd-oomd
# shellcheck disable=SC2016  # se evalúa dentro del sh -c
check "tope de RAM: aplicaciones 3 GB + sistema 1 GB = nunca más de 4 GB" sh -c '[ "$(systemctl show -P MemoryMax user.slice)" = 3221225472 ] && [ "$(systemctl show -P MemoryMax system.slice)" = 1073741824 ]'
# sistema live (ISO) o instalado en un disco
LIVE=0
grep -q 'archisobasedir=' /proc/cmdline && LIVE=1
echo "sistema: $([ "$LIVE" -eq 1 ] && echo live || echo instalado)"
check "usuario 'rros'" id rros
# el nombre del equipo, del kernel (Arch no trae la orden hostname)
host=$(cat /proc/sys/kernel/hostname)
check "nombre de equipo: $host" sh -c "case '$host' in lily*) true ;; *) false ;; esac"
check "kernel $(uname -r)" test -n "$(uname -r)"

BASE=arch
apps="rros-shell kwin_wayland sddm firefox dolphin konsole kate okular gwenview ark kcalc spectacle"
desks="firefox org.kde.dolphin org.kde.konsole org.kde.kate org.kde.okular org.kde.gwenview org.kde.ark org.kde.kcalc mpv
       rros-settings rros-apps rros-welcome rros-updates"
for app in $apps mpv btop flatpak rros rros-config rros-theme rros-apps rros-settings rros-ajustes rros-apply rros-security \
           rros-devices rros-new rros-updates rros-informe nft rfkill udisksctl xdg-user-dir nmcli pactl bluetoothctl \
           kscreen-doctor qdbus6 kwriteconfig6 kreadconfig6 pkexec powerprofilesctl; do
	check "programa: $app" has "$app"
done
for desk in $desks; do
	check "lanzador: $desk.desktop" test -e "/usr/share/applications/$desk.desktop"
done
# lo propio de Lily: iconos, tema de escritorio 2D y 3D, menú Lily, carga, inicio de sesión y arranque
check "antivirus: motor, rros-antivirus y análisis programado" sh -c "command -v clamscan && rros-antivirus estado --json | grep -q '\"motor\":true' && test -f /usr/lib/systemd/system/rros-antivirus.timer"
check "directivas: pam_pwquality en passwd" grep -q pam_pwquality /etc/pam.d/passwd
check "cursores de Lily" test -e /usr/share/icons/Lily-Lirio/cursors/default
check "logotipo de Lily (PNG)" test -s /usr/share/icons/hicolor/256x256/apps/rros.png
check "logotipo de Lily para la barra" test -s /usr/share/icons/hicolor/scalable/apps/rros-symbolic.svg
for icon in rros-settings rros-apps rros-install rros-welcome rros-launchpad rros-updates; do
	check "icono propio: $icon" test -s "/usr/share/icons/hicolor/scalable/apps/$icon.svg"
done
check "tema de escritorio Lily (2D)" test -s /usr/share/plasma/desktoptheme/rros/widgets/panel-background.svg
check "tema de escritorio Lily 3D" test -s /usr/share/plasma/desktoptheme/rros-3d/solid/widgets/panel-background.svg
check "menú Lily de la barra (plasmoide)" test -s /usr/share/plasma/plasmoids/org.rros.menu/contents/ui/main.qml
check "pantalla de carga de Lily" test -s /usr/share/plasma/look-and-feel/org.rros.desktop/contents/splash/Splash.qml
check "inicio de sesión de Lily (SDDM)" sh -c 'test -s /usr/share/sddm/themes/rros/Main.qml && grep -q "^Current=rros" /etc/sddm.conf.d/10-rros.conf'
check "menú de arranque de Lily (GRUB)" test -s /usr/share/grub/themes/rros/background.png
check "Lily Ajustes: la API responde" as_user "rros-settings api GET /api/state | grep -q '\"keys\"'"
check "Lily Ajustes: sin servidor web" sh -c '! rros-settings web --no-open 2>/dev/null'

check "NetworkManager activo" systemctl is-active --quiet NetworkManager
check "polkit activo (o disponible)" sh -c 'systemctl is-active --quiet polkit || test -x /usr/bin/pkexec'
check "snap no instalado" sh -c '! test -e /usr/bin/snap'
check "rros-apply se ejecutó" systemctl is-active --quiet rros-apply
check "zram como swap" sh -c 'swapon --show | grep -q zram'
check "identidad: os-release de Lily" grep -q '^ID=rros' /etc/os-release

for tool in rros-install rros-installer sfdisk mkfs.ext4 mkfs.vfat grub-install efibootmgr tar cryptsetup os-prober; do
	check "instalador: $tool" has "$tool"
done
# shellcheck disable=SC2016
check "instalador: rros-installer disks" sh -c 'rros-installer disks --json | grep -q "\"disks\""'
check "red: el cable lo gestiona NetworkManager" sh -c '! nmcli -t dev status | grep -q ":ethernet:unmanaged"'
check "locale es_ES.UTF-8 generado" sh -c 'locale -a | grep -qix es_ES.utf8'
# seguridad (la aplica rros-apply al arrancar)
check "cortafuegos: tabla inet rros con política drop" sh -c 'nft list table inet rros | grep -q "policy drop"'
check "cortafuegos: nftables arranca con el sistema" systemctl is-enabled --quiet nftables
check "kernel endurecido (kptr_restrict = 2)" test "$(sysctl -n kernel.kptr_restrict 2>/dev/null)" = 2
check "kernel endurecido (protected_regular = 2)" test "$(sysctl -n fs.protected_regular 2>/dev/null)" = 2
# el aislamiento que usa Flatpak: crear un espacio de nombres como usuario
check "aislamiento de aplicaciones (bwrap) como usuario" as_user "bwrap --ro-bind / / --dev /dev --proc /proc true"
check "sudo: configuración de Lily válida" sh -c 'visudo -cqf /etc/sudoers.d/rros'
# shellcheck disable=SC2016
check "rros-security: auditoría" sh -c 'rros-security --json | grep -q "\"score\""'
# dispositivos y archivos
# shellcheck disable=SC2016
check "rros-devices: ve la tarjeta de red" sh -c 'rros-devices lista red --json | grep -q "\"cat\":\"red\""'
check "rros-new: crea un script ejecutable" as_user "cd /tmp && rm -f rros-selftest.sh && rros-new bash rros-selftest >/dev/null && test -x /tmp/rros-selftest.sh"
check "primer inicio: carpetas en español y plantillas" as_user "rros-first-login; test -d ~/Documentos && test -f ~/Plantillas/'Script de Bash.sh'"
if [ "$BASE" = arch ]; then
	# Plasma: SDDM (con inicio automático en el live) y la sesión del usuario con la distribución de Lily
	check "pantalla de inicio de sesión (SDDM) activa" systemctl is-active --quiet sddm
	if [ "$LIVE" -eq 1 ]; then
		check "live: inicio automático en Plasma" grep -qs '^User=rros' /etc/sddm.conf.d/20-rros-live.conf
		i=0
		while ! pgrep -u rros -x rros-shell >/dev/null 2>&1 && [ "$i" -lt 150 ]; do sleep 2; i=$((i + 2)); done
		check "escritorio de Lily arrancado (Lily Shell, ${i} s)" pgrep -u rros -x rros-shell
		check "KWin en marcha (compositor Wayland)" pgrep -u rros -x kwin_wayland
		check "plasmashell no se usa" sh -c '! pgrep -u rros -x plasmashell'
		bus="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u rros)/bus"
		sleep 4
		owners=$(su rros -c "$bus qdbus6" 2>/dev/null)
		check "Lily Shell en el bus de la sesión (org.rros.Shell)" sh -c "echo '$owners' | grep -qx ' *org.rros.Shell'"
		check "avisos de las aplicaciones en Lily Shell" sh -c "su rros -c '$bus qdbus6 org.freedesktop.Notifications /org/freedesktop/Notifications org.freedesktop.Notifications.GetServerInformation' | grep -q 'Lily'"
		# lo que dijo el shell (errores de QML, avisos de Wayland), para el registro de la CI
		journalctl -b _UID="$(id -u rros)" --no-pager 2>/dev/null | grep -E 'rros-shell' | grep -viE 'MESA' | tail -n 30 | sed 's/^/diag: /'
		# las ventanas que ve KWin (capas del shell incluidas), con un guion de KWin que escribe en el registro
		printf '%s\n' 'for (const w of workspace.stackingOrder) print("ventana:", w.resourceClass, "|", w.caption, "| capa", w.layer, "|", w.frameGeometry.x, w.frameGeometry.y, w.frameGeometry.width, w.frameGeometry.height, w.hidden ? "oculta" : "visible", w.opacity);' > /tmp/rros-ventanas.js
		chmod 644 /tmp/rros-ventanas.js
		sid=$(su rros -c "$bus qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript /tmp/rros-ventanas.js rros-ventanas" 2>/dev/null)
		[ -n "$sid" ] && su rros -c "$bus qdbus6 org.kde.KWin /Scripting/Script$sid org.kde.kwin.Script.run" >/dev/null 2>&1
		sleep 1
		journalctl -b _UID="$(id -u rros)" --no-pager 2>/dev/null | grep -F 'ventana:' | tail -n 20 | sed 's/^/diag: /'
		check "Lily Shell dibuja el fondo y la barra de tareas" sh -c "j=\$(journalctl -b _UID=$(id -u rros) --no-pager 2>/dev/null); for c in rros-fondo rros-tareas; do echo \"\$j\" | grep -q \"capa \$c/[a-z]* dibujada\" || exit 1; done"
		if ! pgrep -u rros -x rros-shell >/dev/null 2>&1; then   # para saber por qué: sesión y registro de SDDM
			{
				echo "--- sesiones ---"; loginctl list-sessions --no-legend 2>&1 | head -5
				for sid in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
					loginctl show-session "$sid" -p Type -p Desktop -p Service 2>&1 | tr '\n' ' '; echo
				done
				echo "--- sddm ---"; journalctl -b -u sddm --no-pager 2>&1 | tail -n 25
				echo "--- plasma (usuario) ---"
				journalctl -b _UID="$(id -u rros)" --no-pager 2>&1 | grep -iE 'plasma|kwin|error|fail' | tail -n 30
			} | sed 's/^/diag: /'   # test-iso.sh muestra estas líneas
		fi
		# shellcheck disable=SC2016  # lo expande el sh de dentro
		check "bienvenida abierta (Lily Ajustes)" sh -c 'i=0; while ! pgrep -u rros -x rros-ajustes >/dev/null && [ $i -lt 30 ]; do sleep 1; i=$((i+1)); done; pgrep -u rros -x rros-ajustes'
		i=0
		while ! ls ~rros/.local/share/color-schemes/Lily-*.colors >/dev/null 2>&1 && [ "$i" -lt 60 ]; do sleep 2; i=$((i + 2)); done
		check "colores y barras de título del tema de Lily aplicados al iniciar sesión" sh -c 'ls ~rros/.local/share/color-schemes/Lily-*.colors && test -f ~rros/.local/share/aurorae/themes/Lily/decoration.svg'
		check "tema de escritorio Lily en uso" grep -qsE '^name=rros' ~rros/.config/plasmarc
		renderer=$(su rros -c "$bus qdbus6 org.kde.KWin /KWin supportInformation" 2>/dev/null | sed -n 's/^OpenGL renderer string: //p' | head -1)
		echo "info: KWin dibuja con: ${renderer:-desconocido}"
		case $renderer in *llvmpipe* | *softpipe*)
			check "sin aceleración gráfica: efectos de KWin apagados" grep -qs '^blurEnabled=false' ~rros/.config/kwinrc ;;
		esac
		# el escritorio está listo: test-iso.sh hace aquí la captura de pantalla por el monitor de QEMU
		sleep 10
		echo "RROS_PANTALLA_LISTA"
		sleep 6
		cpu_idle
	fi
fi
if [ "$LIVE" -eq 0 ]; then
	check "instalado: sin inicio automático (SDDM pide usuario y contraseña)" sh -c '! test -e /etc/sddm.conf.d/20-rros-live.conf'
fi
if [ "$LIVE" -eq 0 ]; then
	check "instalado: el usuario tiene contraseña" sh -c 'passwd -S rros | grep -q " P "'
	check "instalado: el usuario administra (sudo)" sh -c 'id -nG rros | grep -qwE "wheel|sudo"'
	check "instalado: la raíz está en /etc/fstab" grep -qE '^[^#[:space:]]+[[:space:]]+/[[:space:]]' /etc/fstab
	check "instalado: GRUB con la entrada de Lily" sh -c 'grep -q Lily /boot/grub/grub.cfg'
	check "instalado: zona horaria de la instalación" sh -c 'readlink /etc/localtime | grep -q Europe/Madrid'
	check "instalado: GRUB con el tema de Lily" grep -q 'GRUB_THEME=.*rros' /etc/default/grub
	if [ -d /sys/firmware/efi ]; then
		check "instalado: arranque UEFI (partición EFI montada, con GRUB)" sh -c 'mountpoint -q /boot/efi && test -e /boot/efi/EFI/BOOT/BOOTX64.EFI'
	fi
fi
# shellcheck disable=SC2016
check "catálogo de apps (54)" sh -c 'test "$(rros-apps list | wc -l)" -ge 50'
check "mimeapps: navegador por defecto" grep -q firefox /etc/xdg/mimeapps.list

if [ "$BASE" = arch ]; then
	for app in pacman arch-chroot genfstab mkinitcpio; do
		check "Arch: $app" has "$app"
	done
	check "idioma del sistema: español" grep -q '^LANG=es_ES.UTF-8' /etc/locale.conf
	check "traducciones de GTK y de la red de Plasma" test -f /usr/share/locale/es/LC_MESSAGES/gtk30.mo -a -f /usr/share/locale/es/LC_MESSAGES/plasma_applet_org.kde.plasma.networkmanagement.mo
	check "Hyprland y sway ya no van en el sistema" sh -c '! command -v Hyprland && ! command -v sway && ! command -v waybar'
	check "VirtualBox: utilidades de invitado (solo arrancan en VirtualBox)" test -e /usr/lib/systemd/system/vboxservice.service
	check "indexador de archivos (Baloo) apagado por defecto" grep -qs 'Indexing-Enabled=false' /etc/xdg/baloofilerc
	check "teclado de la consola: español" sh -c 'grep -q "^KEYMAP=es" /etc/vconsole.conf && ls /usr/share/kbd/keymaps/i386/qwerty/es.map*'
	check "bloqueo tras contraseñas fallidas (pam_faillock)" grep -q pam_faillock /etc/pam.d/system-auth
	check "sudo: el grupo wheel administra" sh -c 'visudo -cqf /etc/sudoers.d/10-rros-wheel'
	check "instalador: cifrado en el initramfs (hook sd-encrypt)" test -e /usr/lib/initcpio/install/sd-encrypt
	check "zona horaria configurada (sin preguntas de systemd-firstboot)" sh -c 'test -e /etc/localtime && systemctl is-enabled systemd-firstboot.service 2>/dev/null | grep -q masked'
	check "Plasma: aspecto de Lily (paquete, colores, barras de título, fondo)" sh -c 'test -f /usr/share/plasma/look-and-feel/org.rros.desktop/contents/layouts/org.kde.plasma.desktop-layout.js && grep -q "Colors:Window" /etc/xdg/kdeglobals && test -f /usr/share/aurorae/themes/Lily/close.svg && grep -q "theme=__aurorae__svg__Lily" /etc/xdg/kwinrc && test -s /usr/share/wallpapers/LilyClasico/contents/images/1920x1080.png'
	check "AppArmor activo (lsm= en el arranque)" test "$(cat /sys/module/apparmor/parameters/enabled 2>/dev/null)" = Y
	check "AppArmor: perfiles cargados" sh -c 'systemctl is-active --quiet apparmor && grep -q . /sys/kernel/security/apparmor/profiles'
	check "actualizaciones: descarga diaria (rros-updates.timer)" sh -c 'command -v checkupdates >/dev/null && systemctl is-enabled --quiet rros-updates.timer'
	check "faillock: límite de intentos de Lily" grep -q '^deny = ' /etc/security/faillock.conf
	check "live: el sistema a copiar está montado" sh -c '! grep -q archisobasedir /proc/cmdline || test -d /run/archiso/airootfs/etc'
	if [ "$LIVE" -eq 0 ]; then
		check "instalado: initramfs propio (sin los hooks de archiso)" sh -c '! test -e /etc/mkinitcpio.conf.d/archiso.conf && lsinitcpio /boot/initramfs-linux.img | grep -q "usr/lib/systemd/systemd" && ! lsinitcpio /boot/initramfs-linux.img | grep -q hooks/archiso'
		check "instalado: sin el llavero temporal del live" sh -c '! test -e /etc/systemd/system/pacman-init.service'
		check "instalado: llavero de pacman inicializado" sh -c 'pacman-key --list-keys >/dev/null 2>&1'
		check "instalado: kernel en /boot" test -e /boot/vmlinuz-linux
		if grep -qs '^rros-root ' /etc/crypttab; then
			check "instalado: raíz cifrada con LUKS2 y abierta en el arranque" sh -c 'cryptsetup status rros-root | grep -q "type: *LUKS2"'
		fi
	fi
fi

# escritorio: el tema de Lily se aplica a Plasma, con fondo
check "rros-theme apply (usuario)" as_user "rros-theme apply --quiet"
check "fondo de pantalla de Lily puesto" as_user "w=\$(cat ~/.local/state/rros/wallpaper) && test -s \"\$w\""
check "Plasma: efectos, entrada y energía escritos" as_user "grep -q '^blurEnabled=' ~/.config/kwinrc && grep -q RepeatDelay ~/.config/kcminputrc && test -s ~/.config/powerdevilrc"
check "terminal: perfil y colores de Lily" as_user "test -s ~/.local/share/konsole/Lily.profile && test -s ~/.local/share/konsole/Lily.colorscheme"

# medidas (informativas, no cuentan): memoria usada con el escritorio arrancado y tamaño del sistema
echo "info: memoria usada $(awk '/^MemTotal:/ {t=$2} /^MemAvailable:/ {a=$2} END {printf "%d MB de %d MB", (t-a)/1024, t/1024}' /proc/meminfo)"
# el diagnóstico al final: su presupuesto de RAM es con el escritorio en reposo, no mientras arranca
check "rros doctor (usuario)" as_user "rros doctor"
# si falla, enseña el diagnóstico completo en el registro para saber qué parte
as_user "NO_COLOR=1 rros doctor" >/dev/null 2>&1 || as_user "NO_COLOR=1 rros doctor; rros-config validate; rros-budget ram" 2>&1 | sed 's/^/diag: /'
echo "info: sistema instalado $(du -sxm / 2>/dev/null | cut -f1) MB (sin /home ni /tmp)"
[ "$LIVE" -eq 0 ] && cpu_idle
# rendimiento medido en cada versión: si empeora por encima del presupuesto del nivel, la CI falla.
# RAM en reposo (sistema instalado, sin el live en memoria) frente a max_idle_ram_mb del perfil; arranque < 90 s
if [ "$LIVE" -eq 0 ]; then
	used=$(awk '/^MemTotal:/ {t=$2} /^MemAvailable:/ {a=$2} END {printf "%d", (t-a)/1024}' /proc/meminfo)
	budget=$(sed -n 's/^max_idle_ram_mb *= *//p' "/usr/share/rros/profiles/$(cat /etc/rros/profile 2>/dev/null || echo lite).toml" | head -1)
	check "rendimiento: RAM en reposo ${used} MB dentro del presupuesto (${budget:-?} MB)" test "$used" -le "${budget:-99999}"
	check "rendimiento: RAM en reposo ${used} MB, como mucho 2 GB en cualquier nivel" test "$used" -le 2048
	disk=$(df -BM --output=used / | tail -1 | tr -dc 0-9)
	check "espacio: el sistema instalado ocupa ${disk} MB (menos de 15 GB)" test "$disk" -le 15360
	boot=$(systemd-analyze time 2>/dev/null | sed -n 's/.*= *\([0-9.]*\)s$/\1/p' | head -1)
	[ -n "$boot" ] && echo "info: arranque ${boot} s (systemd-analyze)"
	check "rendimiento: arranque en menos de 90 s" sh -c "[ -z '$boot' ] || awk 'BEGIN{exit !($boot < 90)}'"
fi
sfs=/run/archiso/bootmnt/arch/x86_64/airootfs.sfs
[ -e "$sfs" ] && echo "info: imagen comprimida del sistema $(du -m "$sfs" | cut -f1) MB"
echo "=== resultado: $ok correctas, $bad con fallo ==="
[ "$bad" -eq 0 ] && echo "RROS_SELFTEST_OK" || echo "RROS_SELFTEST_FAIL"
