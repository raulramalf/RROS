#!/bin/sh
# Teclado de la consola (tty y la pantalla de la contraseña del disco).
# Ubuntu no trae los mapas de kbd: el mapa se genera con ckbcomp desde la distribución XKB (la misma que
# usa el escritorio) y se guarda donde lo busca console-setup (keyboard-setup.service y el initramfs).
#   rros-vconsole                genera el mapa si ha cambiado y lo carga
#   rros-vconsole --save [MAPA]  solo lo genera (el instalador, en un chroot); MAPA cambia la distribución
# La distribución vive en /etc/default/keyboard (KEYMAP= y XKBLAYOUT=); /etc/vconsole.conf es un enlace a él.
set -eu
etc=${RROS_ETC:-/etc}
save=0
if [ "${1:-}" = --save ]; then save=1; shift; fi
KEYMAP=${1:-}
if [ -z "$KEYMAP" ]; then
	XKBLAYOUT=""
	for f in "$etc/default/keyboard" "$etc/vconsole.conf"; do
		# shellcheck disable=SC1090
		[ ! -r "$f" ] || . "$f"
	done
	KEYMAP=${KEYMAP:-${XKBLAYOUT:-es}}
fi
# nombres de kbd que no coinciden con los de XKB
case $KEYMAP in
la-latin1) layout=latam ;;
uk) layout=gb ;;
pt-latin1) layout=pt ;;
br-abnt2) layout=br ;;
de-latin1 | de-latin1-nodeadkeys) layout=de ;;
fr-latin1 | fr-latin9) layout=fr ;;
*) layout=$KEYMAP ;;
esac
case $layout in *[!a-z0-9_-]* | '') echo "rros-vconsole: KEYMAP no válido: $KEYMAP" >&2; exit 1 ;; esac
[ -e "${RROS_XKB:-/usr/share/X11/xkb}/symbols/$layout" ] || { echo "rros-vconsole: distribución desconocida: $layout" >&2; exit 1; }

kbd=$etc/default/keyboard
if ! grep -qx "XKBLAYOUT=\"$layout\"" "$kbd" 2>/dev/null || ! grep -qx "KEYMAP=$KEYMAP" "$kbd"; then
	# escribe en el archivo real aunque /etc/vconsole.conf apunte a él
	cat > "$kbd.new" <<EOF
# Teclado de la consola y de la pantalla de la contraseña del disco (console-setup). En Ubuntu
# /etc/vconsole.conf es un enlace a este archivo. Lo reescribe rros-vconsole; el del escritorio es input.keymap.
KEYMAP=$KEYMAP
XKBMODEL="pc105"
XKBLAYOUT="$layout"
XKBVARIANT=""
XKBOPTIONS=""
BACKSPACE="guess"
EOF
	mv "$kbd.new" "$kbd"
fi
map=$etc/console-setup/cached_UTF-8_del.kmap.gz
if [ "$(cat "$etc/console-setup/rros-layout" 2>/dev/null)" != "$layout" ] || [ ! -s "$map" ]; then
	mkdir -p "$etc/console-setup"
	tmp=$(mktemp)
	if ckbcomp -model pc105 -layout "$layout" > "$tmp" && [ -s "$tmp" ]; then
		gzip -9n < "$tmp" > "$map.new" && mv "$map.new" "$map"
		echo "$layout" > "$etc/console-setup/rros-layout"
	fi
	rm -f "$tmp"
fi
[ "$save" -eq 1 ] || loadkeys -q "$map"
