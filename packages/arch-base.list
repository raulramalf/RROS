# Sistema y escritorio comunes a TODOS los perfiles (Arch Linux). Cada nombre se comprueba en CI con
# `pacman -Si` (scripts/check-packages-arch.sh) contra los repositorios core y extra.

# --- núcleo y arranque ---
base
linux
linux-firmware
sof-firmware            # sonido de los portátiles Intel desde ~2019
alsa-ucm-conf           # perfiles de sonido de cada placa
intel-ucode
amd-ucode
mkinitcpio
grub
efibootmgr
os-prober               # Windows y otros sistemas en el menú de arranque
dosfstools              # partición EFI (rros-install)
mtools
ntfs-3g
cryptsetup              # disco cifrado (LUKS2)
arch-install-scripts    # arch-chroot y genfstab (rros-install)
zram-generator
thermald

# --- sistema ---
networkmanager
network-manager-applet
bluez
bluez-utils
blueman
sudo
polkit
polkit-gnome
nftables
apparmor                # confinamiento de programas (como Ubuntu); se activa con lsm= en el arranque
pacman-contrib          # checkupdates: descarga diaria de actualizaciones (rros-updates.timer)
which
less
nano
man-db
bash-completion
curl
wget
pciutils
usbutils
kbd
xdg-user-dirs
xdg-utils
udisks2
udiskie
gvfs
upower
power-profiles-daemon
brightnessctl

# --- sonido ---
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
pavucontrol
playerctl

# --- escritorio: Hyprland (sway si no hay aceleración gráfica) ---
# --- escritorio: KDE Plasma (Wayland), con el aspecto de RROS (barra arriba y dock) ---
plasma-desktop
plasma-workspace
kwin
kdeplasma-addons      # widgets: papelera del dock, etc.
plasma-nm
plasma-pa
plasma-systemmonitor
powerdevil
bluedevil
kscreen
breeze
breeze-gtk
kde-gtk-config
xdg-desktop-portal-kde
polkit-kde-agent
systemsettings
kinfocenter
kwallet-pam
kwalletmanager
sddm
sddm-kcm
plasma-browser-integration
appmenu-gtk-module      # menú global también para las aplicaciones GTK
ffmpegthumbs
kdegraphics-thumbnailers
phonon-qt6-vlc          # sonidos del sistema

# --- sesión alternativa: Hyprland (y sway sin GPU) ---
hyprland
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk
hyprlock
sway                    # alternativa ligera y sin GPU (máquinas virtuales)
swaybg
swayidle
swaylock
waybar
foot
fuzzel
mako
libnotify
grim
slurp
wl-clipboard
cliphist
kanshi
nwg-dock-hyprland       # dock (estilo «moderno»)
qt5-wayland
qt6-wayland

# --- fuentes, iconos y cursor ---
noto-fonts
noto-fonts-emoji
inter-font
ttf-jetbrains-mono
ttf-liberation
adwaita-icon-theme
papirus-icon-theme

# --- accesibilidad ---
orca
espeak-ng
speech-dispatcher

# --- aplicaciones (las de KDE, que siguen el tema de Plasma) ---
firefox
firefox-i18n-es-es
dolphin
konsole
kate
okular
gwenview
ark
kcalc
spectacle
mpv
btop
flatpak
zip
unzip
7zip
