# Sistema y escritorio comunes a TODOS los perfiles (Arch Linux). Cada nombre se comprueba en CI con
# `pacman -Si` (scripts/check-packages-arch.sh) contra los repositorios core y extra.

# --- núcleo y arranque ---
base
linux
linux-firmware
sof-firmware            # sonido de los portátiles Intel desde ~2019
alsa-ucm-conf           # perfiles de sonido de cada placa
intel-ucode
amd-ucode
mkinitcpio
grub
efibootmgr
os-prober               # Windows y otros sistemas en el menú de arranque
dosfstools              # partición EFI (rros-install)
mtools
ntfs-3g
cryptsetup              # disco cifrado (LUKS2)
arch-install-scripts    # arch-chroot y genfstab (rros-install)
zram-generator
thermald

# --- sistema ---
networkmanager
bluez
bluez-utils
sudo
polkit
nftables
apparmor                # confinamiento de programas; se activa con lsm= en el arranque
pacman-contrib          # checkupdates: descarga diaria de actualizaciones (rros-updates.timer)
which
less
nano
man-db
bash-completion
curl
wget
pciutils
usbutils
kbd
xdg-user-dirs
xdg-utils
udisks2
gvfs
upower
power-profiles-daemon
brightnessctl
libnotify
virtualbox-guest-utils  # en VirtualBox: pantalla que se ajusta a la ventana y portapapeles compartido

# --- sonido ---
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
playerctl
ocean-sound-theme       # sonidos del sistema de Plasma
sound-theme-freedesktop

# --- escritorio: KDE Plasma (Wayland) con el aspecto de RROS (barra arriba, dock 2D o 3D, menú RROS) ---
plasma-desktop
plasma-workspace
kwin
kdeplasma-addons        # Launchpad (panel de aplicaciones) y la papelera del dock
plasma-nm
plasma-pa
plasma-systemmonitor
powerdevil
bluedevil
kscreen
breeze
breeze-gtk
kde-gtk-config
xdg-desktop-portal-kde
polkit-kde-agent
systemsettings
kwallet-pam
sddm
plasma-browser-integration
appmenu-gtk-module      # menú global también para las aplicaciones GTK
ffmpegthumbs
kdegraphics-thumbnailers
phonon-qt6-vlc
qt6-svg                 # RROS Ajustes: iconos SVG
qt6-wayland
qt5-wayland

# --- fuentes, iconos y cursor ---
noto-fonts
noto-fonts-emoji
inter-font
ttf-jetbrains-mono
ttf-liberation

# --- accesibilidad ---
orca
espeak-ng
speech-dispatcher

# --- aplicaciones (las de KDE, que siguen el tema de RROS; Firefox con su logotipo) ---
firefox
firefox-i18n-es-es
dolphin
konsole
kate
okular
gwenview
ark
kcalc
spectacle
mpv
btop
flatpak
zip
unzip
7zip
